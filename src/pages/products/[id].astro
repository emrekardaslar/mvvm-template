---
import type { Lang } from "@domain/models/language";
import { ProductDetailViewModel } from "@application/viewmodels/ProductDetailViewModel";
import LanguageSelector from "@presentation/components/LanguageSelector.astro";
import ProductDetailViewSwitcher from "@presentation/views/ProductDetailView/ProductDetailViewSwitcher";
import { CoordinatorInit } from "@presentation/components/CoordinatorInit";

// Extract the product ID from the URL
const { id } = Astro.params;
const urlParams = Astro.url.searchParams;
const currentLang = (urlParams.get("lang") || "en") as Lang;
const productId = Number(id);
const productDetailViewModel = new ProductDetailViewModel(
  { currentLang }
);

// Fetch initial data for SSR
await productDetailViewModel.fetchProduct(productId);
const initialData = productDetailViewModel.getData();

---

<html lang={currentLang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{initialData.product?.name || "Loading..."}</title>
  </head>
  <body>
    <CoordinatorInit client:load />
    <LanguageSelector currentLang={currentLang} />
    <hr />
    <ProductDetailViewSwitcher
      client:load
      initialData={initialData}
    />
  </body>
</html>
