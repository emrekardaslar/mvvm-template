---
import type { LanguageData } from "../../domain/models/language";
import { ProductDetailViewModel } from "../../presentation/viewmodels/ProductDetailViewModel";
import LanguageSelectorViewSwitcher from "../../presentation/views/LanguageSelectorView/LanguageSelectorViewSwitcher";
import ProductDetailView from "../../presentation/views/ProductDetailView/ProductDetailView";
import { prTexts } from "../../presentation/views/ProductDetailView/productTexts";

// Extract the product ID from the URL
const { id } = Astro.params;
const urlParams = Astro.url.searchParams;
const currentLang: any = urlParams.get("lang") || "en";
const productId = Number(id);
const productDetailViewModel = new ProductDetailViewModel(
  { currentLang }
);

const initialLangData: LanguageData = {
  availableLanguages: ["en", "tr", "ar"],
  currentLang: currentLang,
};

// Fetch initial data for SSR
await productDetailViewModel.fetchProduct(productId, currentLang); // Assuming 'en' for SSR initial fetch
const initialData = productDetailViewModel.getData();

const h1Title = prTexts.title[currentLang];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{initialData.product?.name || "Loading..."}</title>
  </head>
  <body>
    <h1>{h1Title}</h1>
    <hr />
    <LanguageSelectorViewSwitcher client:load initialData={initialLangData} />
    <ProductDetailView
      client:load
      initialData={initialData}
    />
  </body>
</html>
