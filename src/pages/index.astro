---
import api from "@infrastructure/api/api";
import ProductViewEn from "@presentation/views/ProductView/en/ProductView";
import ProductViewTr from "@presentation/views/ProductView/tr/ProductView";
import ProductViewAr from "@presentation/views/ProductView/ar/ProductView";
import LanguageSelector from "@presentation/components/LanguageSelector.astro";
import type { Lang } from "@domain/models/language";
import { CoordinatorInit } from "@presentation/components/CoordinatorInit";

// Language comes from the URL; switching language is a full page load
const currentLang = (Astro.url.searchParams.get("lang") || "en") as Lang;

// SSR Response
const ssrData = await api.fetchSSRData();

// One ViewModel per page: ProductViewModel owns products, filters, and paging
const productInitialData = {
  products: ssrData[currentLang].products,
  filters: ssrData[currentLang].filters,
  currentFilter: ssrData[currentLang].filters[0],
  isLoading: false,
  currentLang,
  totalPages: 5, // mock value; the fake api has a single page of data
};
---

<html lang={currentLang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title>
  </head>
  <body>
    <CoordinatorInit client:load />
    <h1>MVVM</h1>
    <hr />
    <LanguageSelector currentLang={currentLang} />
    <hr />
    {currentLang === "en" && <ProductViewEn client:load initialData={productInitialData} />}
    {currentLang === "tr" && <ProductViewTr client:load initialData={productInitialData} />}
    {currentLang === "ar" && <ProductViewAr client:load initialData={productInitialData} />}
    <br />
    <br />
  </body>
</html>
