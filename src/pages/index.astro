---
import LanguageSelectorViewSwitcher from "../views/LanguageSelectorView/LanguageSelectorViewSwitcher";
import api from "../services/api";
import CounterViewSwitcher from "../views/CounterView/CounterViewSwitcher";
import ProductViewSwitcher from "../views/ProductView/ProductViewSwitcher";
import FilterViewSwitcher from "../views/FilterView/FilterViewSwitcher";
import Pager from "../views/PagerView/Pager";
import { Banner } from "../views/BannerView/Banner";
import type {LanguageData} from "../models/language";

/* import Hpl from "/Users/emrekardaslar/Desktop/Workspace/Self/component-library/dist/esm/components/Hpl/Hpl.js";
 */
// SSR Response
const ssrData = await api.fetchSSRData();
// Language
const defaultLang = "en";
const initialLangData: LanguageData = {
  availableLanguages: ["en", "tr", "ar"],
  currentLang: "en",
};
// Counter
const counterInitialData = {
  count: 0,
  isLoading: false,
  currentLang: defaultLang,
};

// Products (SSR)
const productInitialData = {
  products: ssrData[defaultLang].products,
  isLoading: false,
};

//Filters (SSR)
const initialFilters = {
  filters: ssrData[defaultLang].filters,
  selectedFilter: null,
  currentLang: defaultLang,
};

//Pager
const pagerInitialData = { page: 1, totalPages: 32 };

//Banner
const bannerData = ssrData.banner;
const banner2Data = ssrData.banner2;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title>
  </head>
  <body>
    <h1>MVVM</h1>
    <hr />
    <LanguageSelectorViewSwitcher client:load initialData={initialLangData} />
    <hr />
    <CounterViewSwitcher client:load initialData={counterInitialData} />
    <hr />
    <FilterViewSwitcher client:load initialData={initialFilters} />
    <ProductViewSwitcher client:load initialData={productInitialData} />
    <Banner {...bannerData} />
    <br />
    <Banner {...banner2Data} />
    <br />

    <Pager client:load initialData={pagerInitialData} />
    <!-- <Hpl client:load />
    <Hpl client:load />
    <Hpl client:load /> -->
    <br />
    <br />
  </body>
</html>
