---
import { CounterViewModel } from "../viewmodels/CounterViewModel";
import { ProductViewModel } from "../viewmodels/ProductViewModel";
import { FilterViewModel } from "../viewmodels/FilterViewModel";
import LanguageSelectorViewSwitcher from "../views/LanguageSelectorView/LanguageSelectorViewSwitcher";
import api from "../services/api";
import CounterViewSwitcher from "../views/CounterView/CounterViewSwitcher";
import ProductViewSwitcher from "../views/ProductView/ProductViewSwitcher";
import FilterViewSwitcher from "../views/FilterView/FilterViewSwitcher";
import { LanguageViewModel } from "../viewmodels/LanguageViewModel";

// Counter
const counterViewModel = new CounterViewModel();
const counterInitialData = counterViewModel.getData();

// Language
const languageViewModel = new LanguageViewModel();
const languageInitialData = languageViewModel.getData();
const defaultLang = languageInitialData.currentLanguage;

// Products (SSR)
const initialProducts = await api.fetchProducts(defaultLang, "All");
const productViewModel = new ProductViewModel({
  products: initialProducts,
  isLoading: false,
});
const productInitialData = productViewModel.getData();

// Filters (No SSR data, will be fetched on client)
const filterViewModel = new FilterViewModel();
const filterInitialData = filterViewModel.getData();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title>
  </head>
  <body>
    <h1>MVVM</h1>
    <hr />
    <LanguageSelectorViewSwitcher client:load />
    <hr />
    <CounterViewSwitcher client:load initialData={counterInitialData} />
    <hr />
    <FilterViewSwitcher client:load initialData={filterInitialData} />
    <ProductViewSwitcher client:load initialData={productInitialData} />
  </body>
</html>
