---
import api from "@infrastructure/api/api";
import ProductViewSwitcher from "@presentation/views/ProductView/ProductViewSwitcher";
import FilterViewSwitcher from "@presentation/views/FilterView/FilterViewSwitcher";
import LanguageSelector from "@presentation/components/LanguageSelector.astro";
import type { Lang } from "@domain/models/language";
import { CoordinatorInit } from "@presentation/components/CoordinatorInit";

// Language comes from the URL; switching language is a full page load
const currentLang = (Astro.url.searchParams.get("lang") || "en") as Lang;

// SSR Response
const ssrData = await api.fetchSSRData();

// Products (SSR)
const productInitialData = {
  products: ssrData[currentLang].products,
  isLoading: false,
  currentLang,
};

//Filters (SSR)
const initialFilters = {
  filters: ssrData[currentLang].filters,
  selectedFilter: null,
  currentLang,
};
---

<html lang={currentLang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title>
  </head>
  <body>
    <CoordinatorInit client:load />
    <h1>MVVM</h1>
    <hr />
    <LanguageSelector currentLang={currentLang} />
    <hr />
    <FilterViewSwitcher client:load initialData={initialFilters} />
    <ProductViewSwitcher client:load initialData={productInitialData} />
    <br />
    <br />
  </body>
</html>
