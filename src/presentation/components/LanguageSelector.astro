---
import { LANGS, type Lang } from "@domain/models/language";

interface Props {
  currentLang: Lang;
}

const { currentLang } = Astro.props;
// Links carry only the lang param: other params (filter, page) are
// language-specific and re-derived on the fresh SSR load.
const pathname = Astro.url.pathname;
---

<nav class="language-selector" aria-label="Language">
  <div class="language-selector-buttons">
    {LANGS.map((lang) => (
      <a
        href={`${pathname}?lang=${lang}`}
        class={`language-selector-link ${currentLang === lang ? "selected" : ""}`}
      >
        {lang.toUpperCase()}
      </a>
    ))}
  </div>
</nav>

<style>
  .language-selector-buttons {
    display: inline-flex;
    gap: var(--space-1);
    padding: var(--space-1);
    background-color: var(--color-surface-muted);
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }

  .language-selector-link {
    padding: var(--space-2) var(--space-4);
    border-radius: 999px;
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    transition: background-color var(--transition), color var(--transition);
  }

  .language-selector-link:hover {
    color: var(--color-text);
  }

  .language-selector-link.selected {
    background-color: var(--color-surface);
    color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }
</style>
